{
  "name": "nppweb",
  "version": "0.0.0",
  "private": true,
  "description": "Private, single-owner web notepad that runs on Railway.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build-web.js",
    "start": "node server/src/index.js",
    "dev": "npm run build && node --watch server/src/index.js",
    "test": "node --test \"server/test/**/*.test.js\" \"web/test/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
