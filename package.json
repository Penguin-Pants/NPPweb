{
  "name": "nppweb",
  "version": "0.0.0",
  "private": true,
  "description": "Private, single-owner web notepad that runs on Railway.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.2 <25"
  },
  "scripts": {
    "build": "node scripts/build-web.js",
    "start": "node server/src/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch server/src/index.js",
    "test": "node --test \"server/test/**/*.test.js\" \"web/test/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
